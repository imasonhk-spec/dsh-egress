[Unit]
Description=DSH model HTTP bridge with direct HTTPS upstream
After=network.target

[Service]
Type=simple
User=lgsj
Environment=HTTP_BRIDGE_LISTEN_PORT=25444
Environment=HTTP_BRIDGE_LISTEN_HOST=0.0.0.0
Environment=HTTP_BRIDGE_TARGET_HOST=45.76.203.143
Environment=HTTP_BRIDGE_TARGET_PORT=25443
ExecStart=/usr/local/bin/node /home/lgsj/.dsh/model-http-reverse.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
