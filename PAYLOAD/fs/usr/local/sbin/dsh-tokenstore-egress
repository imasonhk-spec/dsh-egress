#!/usr/bin/python3
"""dsh-tokenstore-egress (dynamic egress for tokens.store).

Resolves the current primary default egress interface / gateway / source IP at
runtime instead of hardcoding them, so a Wi-Fi change needs no config edit.
"""
import ipaddress, json, pathlib, subprocess

def run(*args):
    return subprocess.check_output(args, text=True, timeout=25).strip()

# --- resolve current primary default egress interface dynamically ----------
route = run("ip", "-4", "route", "show", "default")
best = None
for line in route.splitlines():
    parts = line.split()
    metric = 99999
    d = g = None
    for i, t in enumerate(parts):
        if t == "dev":
            d = parts[i + 1]
        elif t == "via":
            g = parts[i + 1]
        elif t == "metric":
            metric = int(parts[i + 1])
    if d and (best is None or metric < best[0]):
        best = (metric, d, g)
if not best:
    raise RuntimeError("no default route available")
_, dev, gw = best

domains = run("resolvectl", "domain", dev).split(":", 1)[-1].split()
if "~tokens.store" not in domains:
    run("resolvectl", "domain", dev, *domains, "~tokens.store")

resolved = run("getent", "ahostsv4", "tokens.store")
ips = sorted({str(ipaddress.IPv4Address(line.split()[0])) for line in resolved.splitlines()})
if not ips:
    raise RuntimeError("tokens.store has no IPv4 address")

# dynamic source IP of the egress iface
src = run("ip", "-4", "-o", "addr", "show", dev).split()[3].split("/")[0]

state = pathlib.Path("/run/dsh-tokenstore-egress.json")
old = json.loads(state.read_text()) if state.exists() else []
rules = run("ip", "-4", "rule", "show")
for addr in ips:
    run("ip", "route", "replace", addr + "/32", "via", gw, "dev", dev, "src", src)
    if not any(line.split()[0] == "5101:" and "to " + addr + " " in line
               for line in rules.splitlines()):
        run("ip", "rule", "add", "priority", "5101", "to", addr + "/32", "lookup", "main")
for addr in set(old) - set(ips):
    ipaddress.IPv4Address(addr)
    run("ip", "rule", "del", "priority", "5101", "to", addr + "/32", "lookup", "main")
    run("ip", "route", "del", addr + "/32", "via", gw, "dev", dev)
state.write_text(json.dumps(ips))
print("tokenstore egress ready (dev=%s gw=%s src=%s): %s" % (dev, gw, src, ", ".join(ips)))
